# ===========================
# Dump Bot configuration
# ===========================
# Copy to .env and adjust.

# --- Engine ---
LOG_LEVEL=INFO
LOG_JSON=false
DATA_DIR=/data
DB_PATH=/data/dump_bot.sqlite3
TIMEZONE=UTC

# --- Binance ---
# Public REST/WS only, no API keys required for read-only futures market data.
BINANCE_FUTURES_REST=https://fapi.binance.com
BINANCE_FUTURES_WS=wss://fstream.binance.com
BINANCE_FUTURES_WS_COMBINED=wss://fstream.binance.com/stream

# --- Universe ---
QUOTE_ASSET=USDT
MIN_QUOTE_VOLUME_24H=10000000   # USD notional 24h volume
MIN_PRICE=0.0005
MAX_SYMBOLS=50                   # hard cap; prefer GAINER_TOP_N for dynamic scanning
UNIVERSE_REFRESH_MIN=15
WHITELIST=                       # comma-separated, optional
BLACKLIST=BTCUSDT,ETHUSDT,USDCUSDT,FDUSDUSDT
EXCLUDE_LEVERAGED=true

# --- Gainer scanner ---
# These defaults are editable from the dashboard /settings page at runtime; the
# values below are seeded on first boot.
GAINER_SCAN_INTERVAL_SEC=60
GAINER_MIN_PCT=5.0
GAINER_TOP_N=50
GAINER_DROP_AFTER_CYCLES=3

# --- Watch / pump detector ---
# Empirically tuned defaults. Lowering PUMP_SCORE_THRESHOLD or
# EXHAUSTION_SCORE_THRESHOLD below their defaults significantly increases
# noise; only adjust upward unless you know what you're doing.
PUMP_MIN_5M_PCT=3.0
PUMP_MIN_15M_PCT=6.0
PUMP_MIN_VOL_RATIO=3.0
PUMP_MIN_OI_PCT=2.0
PUMP_RELATIVE_BTC=1.8
PUMP_SCORE_THRESHOLD=55          # do not lower below 55
EXHAUSTION_SCORE_THRESHOLD=65    # do not lower below 65

# --- Exhaustion / signal ---
CONFIDENCE_LOW=55
CONFIDENCE_MED=70
CONFIDENCE_HIGH=82
WATCH_TTL_SEC=900                # 15m max watch
COOLDOWN_SEC=1800                # 30m per-symbol cooldown after a signal

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# --- Market regime ---
BTC_REGIME_SYMBOL=BTCUSDT
BTC_TREND_LOOKBACK=240           # 1h candles count
BTC_ATR_PERIOD=14

# --- Dashboard ---
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
DASHBOARD_SECRET=please-change-this-long-random-string
DASHBOARD_IP_WHITELIST=          # comma-separated CIDRs, optional
DASHBOARD_BEHIND_PROXY=false

# --- Outcome tracker (paper analysis) ---
OUTCOME_TRACK_SEC=21600          # 6h after signal — wider window for paper-trade outcomes
OUTCOME_INVALIDATION_PCT=2.0     # adverse move that invalidates the short setup
