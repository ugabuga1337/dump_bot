# ===========================
# Dump Bot configuration
# ===========================
# Copy to .env and adjust.

# --- Engine ---
LOG_LEVEL=INFO
LOG_JSON=false
DATA_DIR=/data
DB_PATH=/data/dump_bot.sqlite3
TIMEZONE=UTC

# --- Binance ---
# Public REST/WS only, no API keys required for read-only futures market data.
BINANCE_FUTURES_REST=https://fapi.binance.com
BINANCE_FUTURES_WS=wss://fstream.binance.com
BINANCE_FUTURES_WS_COMBINED=wss://fstream.binance.com/stream

# --- Universe (junk filter only) ---
# Universe is now used purely to pre-filter the symbol set the gainer scanner
# considers: drops low-volume coins, blacklisted tickers, leveraged tokens.
# WS subscriptions are driven by the gainer scanner — not by this list.
QUOTE_ASSET=USDT
MIN_QUOTE_VOLUME_24H=30000000   # USD notional 24h volume
MIN_PRICE=0.0005
UNIVERSE_REFRESH_MIN=15
WHITELIST=                       # comma-separated, optional
BLACKLIST=BTCUSDT,ETHUSDT,USDCUSDT,FDUSDUSDT
EXCLUDE_LEVERAGED=true

# --- Gainer scanner (drives dynamic WS subscriptions) ---
# Each interval: one REST tickers query, delta vs previous snapshot,
# pairs above MIN_PCT become candidates, top TOP_N get an active WS sub.
# Pairs that miss DROP_AFTER_CYCLES consecutive cycles are unsubscribed
# (unless they're currently in WATCH/COOLDOWN).
GAINER_SCAN_INTERVAL_SEC=90
GAINER_MIN_PCT=2.0
GAINER_TOP_N=30
GAINER_DROP_AFTER_CYCLES=3

# --- Watch / pump detector ---
PUMP_MIN_5M_PCT=4.0
PUMP_MIN_15M_PCT=7.0
PUMP_MIN_VOL_RATIO=3.0
PUMP_MIN_OI_PCT=2.5
PUMP_RELATIVE_BTC=1.8
PUMP_SCORE_THRESHOLD=55

# --- Exhaustion / signal ---
EXHAUSTION_SCORE_THRESHOLD=65
CONFIDENCE_LOW=55
CONFIDENCE_MED=70
CONFIDENCE_HIGH=82
WATCH_TTL_SEC=900                # 15m max watch
COOLDOWN_SEC=1800                # 30m per-symbol cooldown after a signal

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# --- Market regime ---
BTC_REGIME_SYMBOL=BTCUSDT
BTC_TREND_LOOKBACK=240           # 1h candles count
BTC_ATR_PERIOD=14

# --- Dashboard ---
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
DASHBOARD_SECRET=please-change-this-long-random-string
DASHBOARD_IP_WHITELIST=          # comma-separated CIDRs, optional
DASHBOARD_BEHIND_PROXY=false

# --- Outcome tracker (paper analysis) ---
OUTCOME_TRACK_SEC=21600          # 6h after signal (early-close on hit_sl/hit_tp2/invalidated)
OUTCOME_INVALIDATION_PCT=2.0     # adverse move that invalidates the short setup
